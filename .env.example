DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
NEON_BRANCH=production
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Local: http://localhost:3000. On Netlify this can stay unset — the site URL is used.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated bootstrap admins. Invited teammates do not need to be listed here.
ADMIN_EMAILS=tech@tennistafoundation.org
ADMIN_BOOTSTRAP_NAME=Tennista Tech
ADMIN_BOOTSTRAP_EMAIL=tech@tennistafoundation.org
ADMIN_BOOTSTRAP_PASSWORD=Password123!
NEON_STORAGE_ENDPOINT=https://BRANCH.storage.REGION.aws.neon.tech
NEON_STORAGE_REGION=us-east-2
NEON_STORAGE_BUCKET=tennista-media
NEON_STORAGE_ACCESS_KEY_ID=replace-with-storage-access-key
NEON_STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret-key
NEON_FUNCTION_HELLO_BASE_URL=https://BRANCH-hello.compute.REGION.aws.neon.tech
RESEND_KEY=re_replace_with_resend_api_key
RESEND_FROM=Tennista Foundation <beth.t@example.com>
